    {
      "name": "Claims",
      "item": [
        {
          "name": "Submit claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"details\": \"My initials are on the inside and there is a distinctive mark near the corner.\"\n}"
            },
            "url": "{{baseUrl}}/api/claims"
          }
        },
        {
          "name": "Submit duplicate claim (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"details\": \"My initials are on the inside and there is a distinctive mark near the corner.\"\n}"
            },
            "url": "{{baseUrl}}/api/claims"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('duplicate claim by same student is rejected', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "My claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/claims/my"
          }
        },
        {
          "name": "Admin list claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/claims"
          }
        },
        {
          "name": "Admin approve claim",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"reason\": \"Ownership details verified by administrator.\"\n}"
            },
            "url": "{{baseUrl}}/api/claims/{{claimId}}/status"
          }
        },
        {
          "name": "Admin reject claim",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"reason\": \"Claim details did not match the reported item.\"\n}"
            },
            "url": "{{baseUrl}}/api/claims/{{claimId}}/status"
          }
        },
        {
          "name": "Admin request proof",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request\": \"Please describe the distinguishing mark in more detail.\"\n}"
            },
            "url": "{{baseUrl}}/api/claims/{{claimId}}/request-proof"
          }
        },
        {
          "name": "Claimant submit proof",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proof\": \"The distinguishing mark is a small scratch beside the left corner.\"\n}"
            },
            "url": "{{baseUrl}}/api/claims/{{claimId}}/proof"
          }
        }
      ]
