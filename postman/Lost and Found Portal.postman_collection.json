    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "lostItemId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": "student1@ced.alliance.edu.in"
    },
    {
      "key": "userPassword",
      "value": "ExamplePass123!"
    },
    {
      "key": "secondUserEmail",
      "value": "student2@ced.alliance.edu.in"
    },
    {
      "key": "secondUserPassword",
      "value": "ExamplePass456!"
    },
    {
      "key": "adminEmail",
      "value": "admin@alliance.edu.in"
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Portal Student\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register second student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Second Student\",\n  \"email\": \"{{secondUserEmail}}\",\n  \"password\": \"{{secondUserPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login second student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{secondUserEmail}}\",\n  \"password\": \"{{secondUserPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Invalid student login (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('invalid credentials are rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Personal email registration rejected (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Personal Account\",\n  \"email\": \"student.personal@gmail.com\",\n  \"password\": \"ExamplePass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('non university email rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized current user (401; run after logout)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('authentication required', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports and search",
      "item": [
        {
          "name": "Create lost report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"lost\",\n  \"itemName\": \"College ID Card\",\n  \"description\": \"Blue card holder with a small star sticker\",\n  \"category\": \"College ID Card\",\n  \"location\": \"Central Library\",\n  \"date\": \"2026-10-23\"\n}"
            },
            "url": "{{baseUrl}}/api/reports/lost"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('lost report created and typed', () => { pm.response.to.have.status(201); if(pm.response.code===201){pm.expect(pm.response.json().item.type).to.eql('lost');pm.collectionVariables.set('lostItemId',pm.response.json().item._id);} });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create found report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"found\",\n  \"itemName\": \"College ID Card\",\n  \"description\": \"Blue card holder with a small star sticker\",\n  \"category\": \"College ID Card\",\n  \"location\": \"Central Library\",\n  \"date\": \"2026-10-23\"\n}"
            },
            "url": "{{baseUrl}}/api/reports/found"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('found report created and typed', () => { pm.response.to.have.status(201); if(pm.response.code===201){pm.expect(pm.response.json().item.type).to.eql('found');pm.collectionVariables.set('itemId',pm.response.json().item._id);} });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create report using general API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"found\",\n  \"itemName\": \"Wallet\",\n  \"description\": \"Brown leather wallet\",\n  \"category\": \"Wallet and Purse\",\n  \"location\": \"Library\",\n  \"date\": \"2026-10-23\"\n}"
            },
            "url": "{{baseUrl}}/api/items"
          }
        },
        {
          "name": "Search items",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items?q=card"
          }
        },
        {
          "name": "Filter found reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items?type=found"
          }
        },
        {
          "name": "Get item by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/items/{{itemId}}"
          }
        },
        {
          "name": "Update own report",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated public identifying details\"\n}"
            },
            "url": "{{baseUrl}}/api/items/{{itemId}}"
          }
        },
        {
          "name": "Delete own report",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/items/{{itemId}}"
          }
        }
      ]
