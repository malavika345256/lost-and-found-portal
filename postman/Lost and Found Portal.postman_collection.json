                "exec": [
                  "pm.test('student receives grouped map summary', () => { pm.response.to.have.status(200); if(pm.response.code===200){const d=pm.response.json();pm.expect(d.summary.totalReports).to.be.a('number');pm.expect(d.locations).to.be.an('array');pm.expect(d.locations.every(x => x.categories && x.reportCount >= 0)).to.eql(true);} });"
