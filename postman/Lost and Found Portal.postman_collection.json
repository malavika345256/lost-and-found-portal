{
  "info": {
    "name": "College Lost and Found Portal API",
    "description": "Cookie authenticated API workflow. Postman stores the portalToken HttpOnly cookie for localhost automatically. Seed an administrator with npm run seed:admin before admin requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
