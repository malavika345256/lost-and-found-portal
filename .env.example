PORT=3000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set this only when serving the frontend from a different origin.
FRONTEND_ORIGIN=
# Optional one-time admin bootstrap settings (run npm run seed:admin).
# Set these as Render environment variables if bootstrapping an admin there.
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=replace-with-your-admin-email
ADMIN_PASSWORD=replace-with-a-strong-admin-password
