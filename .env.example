PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/lost_found_portal
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set this only when serving the frontend from a different origin.
FRONTEND_ORIGIN=
# Optional one-time admin bootstrap (run npm run seed:admin)
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@alliance.edu.in
ADMIN_PASSWORD=replace-with-a-strong-admin-password
